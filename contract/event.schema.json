{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One event on GET /v1/events (the SSE data field; the SSE id is the resume cursor)",
  "type": "object",
  "required": ["type", "at", "id"],
  "properties": {
    "type": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+$", "description": "known types are listed in docs/labs.md; clients ignore types they do not know" },
    "at": { "type": "string", "format": "date-time" },
    "id": { "type": "string", "minLength": 1 },
    "session": { "type": "string" },
    "text": { "type": "string" },
    "task_id": { "type": "string" },
    "waiting_on": { "type": "string", "description": "why a lab agent's run is held: approval (the owner approves it at approve_url)" },
    "approve_url": { "type": "string", "pattern": "^https://" },
    "status": { "type": "string" },
    "summary": { "type": "string" },
    "sandbox": { "type": "string" },
    "kind": { "type": "string" },
    "used": { "type": "number" },
    "limit": { "type": "number" }
  }
}
