{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apps this person's groups may install: GET /v1/apps",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "array",
      "description": "every version that isn't deleted, newest first per name; withdrawn versions stay listed with withdrawn_at",
      "items": {
        "type": "object",
        "required": ["name", "title", "version", "signer", "sha256", "bytes", "package"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
          "title": { "type": "string" },
          "version": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "signer": {
            "type": "object",
            "required": ["fingerprint"],
            "properties": { "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{4}( [0-9a-f]{4}){3}$" }, "name": { "type": "string" } }
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "of the .labapp file" },
          "bytes": { "type": "integer", "minimum": 1 },
          "runtime": { "type": "string" },
          "permissions": { "type": "object" },
          "published": { "type": "string", "format": "date-time" },
          "withdrawn_at": { "type": ["string", "null"] },
          "package": { "type": "string", "pattern": "^/v1/apps/", "description": "GET it for the .labapp bytes (ETag = sha256)" }
        }
      }
    }
  }
}
